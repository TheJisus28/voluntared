{
    "name": "unicordoba/voluntared",
    "description": "VoluntaRed: plataforma digital para la vinculación entre voluntarios y fundaciones",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "composer/ca-bundle": "^1.5",
        "firebase/php-jwt": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "setasign/fpdf": "^1.8",
        "shuchkin/simplexlsxgen": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "instalar": "php database/instalar.php",
        "servidor": "php -S localhost:8000 -t public public/index.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
